# Copy to .env and adjust. All values are optional.

# Where the browser sends API calls.
#   dev (npm run dev): defaults to same-origin; /v1 and /agent are proxied to
#                      VITE_API_PROXY_TARGET, which avoids CORS.
#   production build:  defaults to https://app.msysconsultgh.com
VITE_API_BASE_URL=

# Dev-server proxy target (only used by `npm run dev`).
VITE_API_PROXY_TARGET=https://app.msysconsultgh.com

# Code sent as the deposit `source` for each telco.
VITE_BILLER_MTN=MTN
VITE_BILLER_TELECEL=TELECEL
VITE_BILLER_AT=AT

# Set to true to run without a backend (fake responses, shows a DEMO badge).
VITE_MOCK_API=false
