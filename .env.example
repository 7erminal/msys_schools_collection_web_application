# Copy to .env and adjust.

# Where the browser sends API calls. Leave empty to use same-origin
# (in dev, /v1 is then proxied to VITE_API_PROXY_TARGET - avoids CORS).
VITE_API_BASE_URL=

# Dev-server proxy target for /v1 requests (only used by `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:8080

# Biller codes sent to /v1/api/account-query for each telco.
VITE_BILLER_MTN=MTN
VITE_BILLER_TELECEL=TELECEL
VITE_BILLER_AT=AT

# Set to true to run without a backend (fake responses, shows a DEMO badge).
VITE_MOCK_API=false
